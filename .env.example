# ============================================================
# AGENTIC AI STUDY ASSISTANT — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values. Deploying? Read docs/DEPLOYMENT.md.
#
# In production (NODE_ENV=production) each service checks its settings at startup and refuses
# to run, naming the setting, if any line marked REQUIRED IN PRODUCTION is missing, still a
# placeholder from this file, or unsafe. Generate secrets with:  openssl rand -hex 32
#
# Local development needs none of this: npm run dev:local generates its own secrets.
# ============================================================

# ---- APP ----
NODE_ENV=development
APP_NAME="Agentic AI Study Assistant"
# REQUIRED IN PRODUCTION: your site's https:// address. Links in emails point here.
APP_URL=http://localhost:3000

# ---- API GATEWAY ----
API_GATEWAY_PORT=4000
API_GATEWAY_URL=http://localhost:4000

# ---- MICROSERVICES (internal) ----
USER_SERVICE_URL=http://localhost:4001
STUDY_SERVICE_URL=http://localhost:4002
ANALYTICS_SERVICE_URL=http://localhost:4003
AI_ORCHESTRATOR_URL=http://localhost:8000

# ---- AI AGENTS (internal ports) ----
PLANNER_AGENT_URL=http://localhost:8001
TUTOR_AGENT_URL=http://localhost:8002
QUIZ_AGENT_URL=http://localhost:8003
REVISION_AGENT_URL=http://localhost:8004
ANALYZER_AGENT_URL=http://localhost:8005
ACCESSIBILITY_AGENT_URL=http://localhost:8006

# ---- JWT ----
# REQUIRED IN PRODUCTION: two different random values of 32+ characters (openssl rand -hex 32).
# Anyone who knows JWT_SECRET can sign in as anyone, admins included.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_SECRET_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- POSTGRESQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agentic_ai_study
POSTGRES_USER=postgres
# REQUIRED for docker compose.
POSTGRES_PASSWORD=change_me_to_a_strong_password
DATABASE_URL=postgresql://postgres:change_me_to_a_strong_password@localhost:5433/agentic_ai_study

# ---- MONGODB ----
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=agentic_ai_logs
MONGO_USER=mongo
MONGO_PASSWORD=mongo_password_change_in_prod
MONGODB_URL=mongodb://mongo:mongo_password_change_in_prod@localhost:27017/agentic_ai_logs?authSource=admin

# ---- REDIS ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REQUIRED for docker compose (Postgres and Redis passwords; any long random value).
REDIS_PASSWORD=redis_password_change_in_prod
REDIS_URL=redis://:redis_password_change_in_prod@localhost:6379

# ---- AI TUTOR, QUIZZES AND PLAN DRAFTING (study-service) ----
# Any OpenAI-compatible API. Optional: without a key the app says the AI is unavailable and
# never invents answers. Check a key without printing it: npm run ai:check (reads .local/ai.env).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash
AI_API_KEY=
# Gemini 3 models think before answering; "low" keeps replies quick. Leave empty for other providers.
AI_REASONING_EFFORT=low
# Asked, in order, when the main model is slow or overloaded (comma-separated).
AI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemini-flash-lite-latest
# Optional tuning (milliseconds): per-model wait before giving up, and the whole question's budget.
# AI_MODEL_TIMEOUT_MS=20000
# AI_TOTAL_TIMEOUT_MS=50000

# ---- OPENAI (only for the optional Python agents: docker compose --profile agents) ----
OPENAI_API_KEY=sk-your-openai-api-key-here
# To use a local model instead of OpenAI (Ollama), set:
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1   (http://localhost:11434/v1 when running agents on the host)
#   OPENAI_MODEL=qwen2.5:3b
OPENAI_BASE_URL=
# Seconds the orchestrator waits for an agent (raise for slow local models)
AGENT_TIMEOUT_SECONDS=180
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# ---- VECTOR DATABASE (FAISS local by default) ----
VECTOR_DB_TYPE=faiss
FAISS_INDEX_PATH=./data/faiss_index
# For Pinecone (optional):
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=agentic-ai-study

# ---- GOOGLE OAUTH (optional) ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
# Per signed-in account (per address when signed out), per window. A dashboard visit alone makes
# several calls; this is abuse protection, not a quota.
RATE_LIMIT_MAX_REQUESTS=1000

# ---- FILE UPLOAD ----
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# ---- CORS ----
# REQUIRED IN PRODUCTION: your site's https:// address (comma-separate several). The session
# refresh check compares the request's Origin against this list.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- LOGGING ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- CELERY (background tasks) ----
CELERY_BROKER_URL=redis://:redis_password_change_in_prod@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_password_change_in_prod@localhost:6379/2

# ---- NEXT.JS PUBLIC VARS ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Agentic AI Study Assistant"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (signup verification, password reset) ───
# smtp: real delivery (required in production). capture: development only; mail is held in
# memory and shown at /dev/mailbox, never delivered. Real SMTP delivery is untested in this prototype.
# REQUIRED IN PRODUCTION: smtp, with SMTP_HOST and MAIL_FROM set.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASS=change_me
MAIL_FROM="Agentic Study <no-reply@example.com>"
# Off only by explicit operator decision; unverified accounts cannot sign in while true.
REQUIRE_EMAIL_VERIFICATION=true
# Development mailbox in the gateway (never enabled in production).
DEV_MAILBOX=false

# ─── Sessions ───
# Refresh cookie Secure flag. Defaults to true in production; set false only for plain-http localhost.
COOKIE_SECURE=true
# Express "trust proxy" for the gateway (which hops may set X-Forwarded-For).
TRUST_PROXY=loopback

# ─── Rate limits (per IP, 15 minutes) ───
# Sign-in, sign-up and link attempts per account tried, per address.
AUTH_RATE_LIMIT_MAX=10
# Ceiling per address across all credential and email endpoints (a class signing up together fits).
AUTH_IP_RATE_LIMIT_MAX=100
EMAIL_RATE_LIMIT_MAX=5

# ─── Network ───
# Interface each Node service listens on (0.0.0.0 in containers, 127.0.0.1 for local dev).
HOST=0.0.0.0

# ─── Admin console traffic view ───
# Shared secret user-service uses to read the gateway's request counters (unset = view disabled).
INTERNAL_METRICS_TOKEN=change_me_to_a_long_random_value
API_GATEWAY_INTERNAL_URL=http://api-gateway:4000

# ─── Docker compose ───
# REQUIRED for docker compose: your domain. Its DNS must point at this server, with ports 80 and
# 443 open; Caddy then obtains HTTPS certificates itself. APP_URL is https://<this address>.
SITE_ADDRESS=study.example.com
# Port for reaching the web app from the server itself (checks only; it is not public).
WEB_PORT=3000

# ─── Privacy and terms pages (web build) ───
# REQUIRED before a public launch: who runs the service, and where people send privacy requests.
# Read when the web app is built, so rebuild after changing them.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
