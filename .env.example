# ============================================================
# AGENTIC AI STUDY ASSISTANT — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# ---- APP ----
NODE_ENV=development
APP_NAME="Agentic AI Study Assistant"
APP_URL=http://localhost:3000

# ---- API GATEWAY ----
API_GATEWAY_PORT=4000
API_GATEWAY_URL=http://localhost:4000

# ---- MICROSERVICES (internal) ----
USER_SERVICE_URL=http://localhost:4001
STUDY_SERVICE_URL=http://localhost:4002
ANALYTICS_SERVICE_URL=http://localhost:4003
AI_ORCHESTRATOR_URL=http://localhost:8000

# ---- AI AGENTS (internal ports) ----
PLANNER_AGENT_URL=http://localhost:8001
TUTOR_AGENT_URL=http://localhost:8002
QUIZ_AGENT_URL=http://localhost:8003
REVISION_AGENT_URL=http://localhost:8004
ANALYZER_AGENT_URL=http://localhost:8005
ACCESSIBILITY_AGENT_URL=http://localhost:8006

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- POSTGRESQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_ai_study
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_in_prod
DATABASE_URL=postgresql://postgres:postgres_password_change_in_prod@localhost:5432/agentic_ai_study

# ---- MONGODB ----
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=agentic_ai_logs
MONGO_USER=mongo
MONGO_PASSWORD=mongo_password_change_in_prod
MONGODB_URL=mongodb://mongo:mongo_password_change_in_prod@localhost:27017/agentic_ai_logs

# ---- REDIS ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_in_prod
REDIS_URL=redis://:redis_password_change_in_prod@localhost:6379

# ---- OPENAI ----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# ---- VECTOR DATABASE (FAISS local by default) ----
VECTOR_DB_TYPE=faiss
FAISS_INDEX_PATH=./data/faiss_index
# For Pinecone (optional):
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=agentic-ai-study

# ---- GOOGLE OAUTH (optional) ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- FILE UPLOAD ----
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- LOGGING ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- CELERY (background tasks) ----
CELERY_BROKER_URL=redis://:redis_password_change_in_prod@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_password_change_in_prod@localhost:6379/2

# ---- NEXT.JS PUBLIC VARS ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Agentic AI Study Assistant"
NEXT_PUBLIC_APP_URL=http://localhost:3000
