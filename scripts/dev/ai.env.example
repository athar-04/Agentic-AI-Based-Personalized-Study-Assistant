# AI provider for the local stack. Copy this file to .local/ai.env (never committed)
# and fill in AI_API_KEY for ONE provider. Any OpenAI-compatible API works.

# ── Google Gemini (free tier) — key from https://aistudio.google.com/apikey ──
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash
AI_API_KEY=
# Gemini 3 models think before answering; "low" keeps replies quick.
AI_REASONING_EFFORT=low
# Tried in order when the main model is overloaded (comma-separated). Gemma runs on separate
# capacity, so it often still answers when the Flash models are busy. npm run ai:check tests them all.
AI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemini-flash-lite-latest

# ── Groq — key from https://console.groq.com → API Keys ──
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=

# ── OpenAI (paid) ──
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
